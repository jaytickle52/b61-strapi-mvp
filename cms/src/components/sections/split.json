{
  "collectionName": "components_sections_split",
  "info": {
    "displayName": "Split",
    "icon": "layout",
    "description": "Text beside an image"
  },
  "options": {},
  "attributes": {
    "heading": {
      "type": "string",
      "required": true
    },
    "body": {
      "type": "blocks"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "imagePosition": {
      "type": "enumeration",
      "enum": [
        "left",
        "right"
      ],
      "default": "right"
    },
    "tone": {
      "type": "enumeration",
      "enum": [
        "light",
        "muted",
        "brand",
        "dark"
      ],
      "default": "light"
    },
    "button": {
      "type": "component",
      "repeatable": false,
      "component": "shared.button"
    }
  }
}
