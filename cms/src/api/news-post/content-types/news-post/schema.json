{
  "kind": "collectionType",
  "collectionName": "news_posts",
  "info": {
    "singularName": "news-post",
    "pluralName": "news-posts",
    "displayName": "News post",
    "description": "News and announcements; parents-only posts show in the parent feed only"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "date": {
      "type": "date",
      "required": true
    },
    "audience": {
      "type": "enumeration",
      "enum": [
        "public",
        "parents"
      ],
      "default": "public",
      "required": true
    },
    "summary": {
      "type": "text",
      "maxLength": 200
    },
    "body": {
      "type": "blocks"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
