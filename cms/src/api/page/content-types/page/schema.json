{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page",
    "description": "Website pages built from sections"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "seoDescription": {
      "type": "text",
      "maxLength": 160
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.hero",
        "sections.split",
        "sections.card-grid",
        "sections.stats-band",
        "sections.cta-band",
        "sections.prose"
      ]
    }
  }
}
