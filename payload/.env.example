DATABASE_URL=postgres://user:pass@host:5432/db
SCHOOL_SECRET=one-long-random-string
SEED_DEMO=true
SEED_SCHOOL=cedar-ridge
SCHOOL_TIMEZONE=America/New_York
PARENT_PASSWORD=

# Email (src/email). Without RESEND_API_KEY emails are only written to the log.
RESEND_API_KEY=
# The platform sender, used when a school hasn't set its own. Must be on a domain verified in Resend.
EMAIL_FROM_ADDRESS=no-reply@banner61.com
EMAIL_FROM_NAME=Banner 61
# Optional: the site's address for links in emails (on Vercel the production URL is used).
NEXT_PUBLIC_SERVER_URL=
# Optional, local only: save every email as an .html file here instead of just logging it.
EMAIL_PREVIEW_DIR=

# Forms spam check (optional): Cloudflare Turnstile. Both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Photos (optional): "Suggest alt text" in Media. Off without a key.
ANTHROPIC_API_KEY=
# ALT_TEXT_MODEL=claude-haiku-5-5
